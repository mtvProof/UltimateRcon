# ------------------------------
# Global config (CONFIGS/config.json)
# Prefix format: UR_CONFIG__PATH__TO__KEY
# ------------------------------
UR_CONFIG__DISCORD_SERVER_ID=
UR_CONFIG__STEAM_API_KEY=

# Global population bot
UR_CONFIG__GLOBAL_POP_BOT__ENABLED=false
UR_CONFIG__GLOBAL_POP_BOT__BOT_TOKEN=

# Player profiler
UR_CONFIG__PLAYER_PROFILER__ENABLED=false
UR_CONFIG__PLAYER_PROFILER__BOT_TOKEN=

# ------------------------------
# Server config defaults (applies to every file in CONFIGS/SERVERS)
# Prefix format: UR_SERVER_DEFAULT__PATH__TO__KEY
# ------------------------------
# UR_SERVER_DEFAULT__SERVER_ENABLED=true

# ------------------------------
# Server 1 overrides (CONFIGS/SERVERS/server1.json)
# Prefix format: UR_SERVER1__PATH__TO__KEY
# ------------------------------
UR_SERVER1__SERVER_ENABLED=false
UR_SERVER1__SERVER_SHORTNAME=Us 10x
UR_SERVER1__SERVER_SPECIAL_ID=server1
UR_SERVER1__SERVER_IP=
UR_SERVER1__SERVER_PORT=28016
UR_SERVER1__RCON_PORT=28017
UR_SERVER1__RCON_PASS=
UR_SERVER1__BOT_TOKEN=
UR_SERVER1__BOT_CLIENT_ID=

# Optional toggles for server1
UR_SERVER1__LEADERBOARD__ENABLED=false
UR_SERVER1__SERVER_STATUS_PAGE__ENABLED=false
UR_SERVER1__SERVER_LOGGING__F7_REPORT_LOGGING__ENABLED=false

# ------------------------------
# Server 2 overrides (CONFIGS/SERVERS/server2.json)
# Prefix format: UR_SERVER2__PATH__TO__KEY
# ------------------------------
UR_SERVER2__SERVER_ENABLED=false
UR_SERVER2__SERVER_SHORTNAME=Us 5x
UR_SERVER2__SERVER_SPECIAL_ID=server2
UR_SERVER2__SERVER_IP=
UR_SERVER2__SERVER_PORT=28016
UR_SERVER2__RCON_PORT=28017
UR_SERVER2__RCON_PASS=
UR_SERVER2__BOT_TOKEN=
UR_SERVER2__BOT_CLIENT_ID=

# Optional toggles for server2
UR_SERVER2__LEADERBOARD__ENABLED=false
UR_SERVER2__SERVER_STATUS_PAGE__ENABLED=false
UR_SERVER2__SERVER_LOGGING__F7_REPORT_LOGGING__ENABLED=false

# ------------------------------
# Value type rules
# - true/false for booleans
# - numbers for numeric values
# - arrays/objects as JSON, for example:
#   UR_SERVER1__RCON_SETTINGS__RCON_COMMANDS__STAFF_ROLES=["123","456"]
# ------------------------------
