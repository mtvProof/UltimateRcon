# Ultimate Rcon+ Environment Configuration Template
# Copy this file to create your own environment configuration:
# - For Portainer Stack deployment: Copy and paste into Portainer environment variables
# - For local development: Copy to .env and fill in your values

# =======================
# Runtime Configuration
# =======================
UR_ENV_ONLY=true
GIT_REPO=https://github.com/mtvProof/UltimateRcon.git
GIT_BRANCH=main
DATABASE_DIR=./data/database
IMAGESTORE_DIR=./data/imagestorage

